public class Main {
    public static void main(String[] args) {
        int[] marks = {85, 90, 78, 92, 88};

        int sum = 0;
        for (int i = 0; i < marks.length; i++) {
            sum += marks[i];
        }

        double average = (double) sum / marks.length;
        System.out.println("Average Marks = " + average);
    }
}


 Output
Average Marks = 86.6
